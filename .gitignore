# ===========================================================================
# Migration Factory - .gitignore
# Objectif : ne versionner que le code/config necessaire.
# ===========================================================================

# --- Secrets & environnement (NE JAMAIS COMMITER) -------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/

# --- Node / Frontend ------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
coverage/
dist/
build/
.next/
.cache/
*.local
# Caches de build TS / lint
*.tsbuildinfo
.eslintcache

# --- Logs -----------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev-debug.log
backend/logs/

# --- Donnees (hors du repo : RGPD / volumineux) ---------------------------
# CSV de donnees clients importees (les mapping_*.csv de sql/ restent versionnes)
importfichiers/*.csv
# Archives de donnees generees
docs/files.zip
docs/catalogIfs/*.zip
*.dump
*.dump.gz
*.sqlite
*.sqlite3
# Fichiers uploades / generes au runtime (backend Flask)
backend/uploads/
backend/instance/
backend/exports/
*.pid

# --- Outils IA / IDE / dev ------------------------------------------------
.claude/
.cursor/
.taskmaster/
.playwright-mcp/
.vscode/
.idea/
.devcontainer/
graphify-out/

# --- OS / Editeurs --------------------------------------------------------
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Fichiers temporaires / sauvegardes d'editeur
*.bak
*.tmp
*.old
*.orig
*~
.*.swp

# --- Task Master ----------------------------------------------------------
tasks.json
tasks/
