# =====================================================================
# Configuration du déploiement Open WebUI + mcpo (outils MCP)
# Copier ce fichier en ".env" et adapter les valeurs.
#   cp .env.example .env
# =====================================================================

# --- Réseau / serveur ---
SERVER_IP=10.190.100.58
DOCKER_NETWORK=ia-net

# --- Ollama (déjà installé sur le serveur) ---
OLLAMA_BASE_URL=http://10.190.100.58:11434

# --- Open WebUI ---
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_PORT=3001
OPENWEBUI_VOLUME=open-webui

# --- mcpo (proxy MCP -> OpenAPI) ---
MCPO_IMAGE=ghcr.io/open-webui/mcpo:main
# Port HOTE d'exposition (le conteneur reste sur 8000 en interne).
# 8000 est souvent déjà pris : on utilise 8800 par défaut.
MCPO_PORT=8800
# Clé d'API protégeant l'accès aux outils (à mettre aussi côté Open WebUI)
MCPO_API_KEY=trimet-mcp-CHANGE_ME

# --- Base de données ---
# Utilisé pour générer la chaîne de connexion du serveur MCP postgres.
# ATTENTION : le compte 'postgres' a TOUS les droits (lecture ET écriture).
PG_HOST=10.190.100.58
PG_PORT=5432
PG_DB=sap_migration_db
PG_USER=postgres
PG_PASSWORD=trimet2025
