# Environnement Flask
FLASK_APP=app.py
FLASK_ENV=development  # development, test, ou production

# Sécurité
SECRET_KEY=change-this-to-a-secure-random-key
JWT_SECRET_KEY=change-this-to-a-different-secure-random-key

# Connexion à la base de données
# Ces paramètres sont optionnels si vous utilisez le fichier migrationFactory/.env
# L'application utilisera automatiquement les paramètres PG_* de migrationFactory/.env
DATABASE_URI=postgresql://user:password@localhost:5432/sap_migration
# Ou vous pouvez spécifier les paramètres individuellement (priorité sur migrationFactory/.env)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=sap_migration
# PG_SCHEMA=raw_data
# PG_USER=postgres
# PG_PASSWORD=postgres

# Chemins d'accès
SAP_EXTRACTION_PATH=/chemin/absolu/vers/migrationFactory/sap_extraction

# Configuration des logs
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Limites d'API
RATE_LIMIT_DEFAULT=50000/day;5000/hour
MAX_EXPORT_ROWS=100000
EXPORT_CHUNK_SIZE=5000

# Configuration de l'extraction
MAX_CONCURRENT_EXTRACTIONS=3
MAX_HISTORY_ITEMS=50
EXTRACTION_TIMEOUT=3600  # secondes

# Configuration CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Cache Redis
# En Docker : le service "redis" du docker-compose est utilise automatiquement
#   (REDIS_URL par defaut = redis://redis:6379/0), rien a configurer ici.
# Hors Docker (dev local) : decommenter pour pointer un Redis local, sinon repli
#   automatique en cache memoire.
# REDIS_URL=redis://localhost:6379/0
# CACHE_ENABLED=true            # false pour desactiver totalement le cache
# MAINTENANCE_CACHE_TTL=300     # duree de vie (s) du cache articles (liste + stats)

# Assistant IA (Ollama local + rôle PostgreSQL lecture seule)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AI_DB_USER=readonly_ai
AI_DB_PASSWORD=change-me            # doit correspondre au mot de passe du rôle readonly_ai
AI_MAX_ROWS=500                     # nb max de lignes affichées dans l'UI
AI_EXPORT_MAX_ROWS=50000           # nb max de lignes pour l'export Excel
AI_TIMEOUT_SECONDS=0               # timeout d'appel au modèle local (s) ; 0 = aucun délai imparti (worker CPU lent)
AI_NUM_CTX=4096                    # taille de contexte du modèle SQL
AI_NUM_PREDICT=256                 # plafond de tokens générés (SQL+explication) ; bas = plus rapide
# Recherche sémantique (pgvector + embeddings locaux Ollama)
AI_EMBED_MODEL=bge-m3              # modèle d'embeddings (ollama pull bge-m3), 1024 dims
AI_EMBED_ENABLED=true              # false => repli sur la sélection lexicale (mots-clés/FTS)
AI_EMBED_TIMEOUT_SECONDS=30        # timeout d'appel au modèle d'embeddings (secondes)
AI_EMBED_KEEP_ALIVE=24h            # garde bge-m3 en RAM (requiert OLLAMA_MAX_LOADED_MODELS>=2)
# Cache sémantique : réutilise le SQL d'une question passée très proche
AI_CACHE_ENABLED=true              # false => toujours rappeler Ollama
AI_CACHE_THRESHOLD=0.94            # similarité cosinus minimale pour un hit de cache (0-1)
# Auto-correction : retente une fois si le SQL référence une colonne/table inexistante
AI_SELFHEAL_ENABLED=true
# Traitement en arrière-plan : les questions sont mises en file (public.ai_jobs)
# et traitées par un worker -> la requête HTTP ne bloque plus (fin des timeouts).
AI_JOBS_ENABLED=true               # false => les jobs ne sont plus traités (à éviter)
AI_JOBS_POLL_SECONDS=1.0           # fréquence de scrutation de la file par le worker
# Prompting 2 phases (CoT) : le modèle explicite tables/jointures/règles AVANT le SQL.
# Gain de precision sur les jointures, mais +60-130s de latence/requete sur CPU.
AI_COT_ENABLED=true                # false => generation directe {sql, explication}
AI_NUM_PREDICT_COT=640             # plafond de tokens en mode CoT (raisonnement + SQL)
# Packs de connaissances métier (skills) : JSON par domaine dans backend/config/skills/
# (jointures/FK, valeurs/enums, requêtes-types) injectés selon le domaine de la question.
AI_SKILL_ENABLED=true              # false => aucun bloc CONNAISSANCES METIER injecté (repli)
AI_SKILL_MAX_PACKS=1               # nb max de packs injectés par question (1 conseillé, budget tokens)
AI_SKILL_MAX_CHARS=700             # plafond de caractères par pack (~220 tokens)
# AI_SKILLS_PATH=...               # par défaut backend/config/skills (rarement à changer)
# Knowledge cards (cards granulaires derivees des packs) + Knowledge Graph (jointures FK DDIC)
AI_KNOWLEDGE_ENABLED=true          # false => repli sur les packs entiers (build_skill_block)
AI_KNOWLEDGE_MAX_CHARS=500         # plafond du bloc cards (~160 tokens) ; necessite build_ai_index --only knowledge
AI_KG_ENABLED=true                 # false => pas de sous-graphe de jointures injecte
# Few-shots vivants : une reponse votee pouce-haut devient un exemple (sans reindexation)
AI_FEEDBACK_FEWSHOT_ENABLED=true   # false => seuls les few-shots du dataset statique
# Préchauffage (keep-warm) : garde le modèle + le prompt système en cache
AI_KEEPWARM_ENABLED=true           # true/false pour activer le préchauffage périodique
AI_KEEPWARM_SECONDS=60             # intervalle entre deux préchauffages (secondes)
AI_KEEPWARM_LOCK_PORT=5051         # port localhost de verrou singleton (multi-workers)