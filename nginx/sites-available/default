##
# /etc/nginx/sites-available/default
#
# Portail d'accueil statique (/var/www/html/index.html).
#
# Il repond sur PLUSIEURS ports pour que les anciens signets tombent dessus :
#   :80    (default_server)
#   :3000  (ancien port du frontend Vite ; le conteneur est desormais binde sur
#           127.0.0.1:3100, ce port hote est donc libre pour nginx)
#   :8080  -> servi par migration-factory-8080.conf (meme contenu, vhost separe)
#
# Quel que soit le chemin demande, on renvoie la page d'accueil.
#
# L'application Migration Factory est servie par nginx sur le port 8081
# (voir migration-factory.conf).
##

server {
	listen 80 default_server;
	listen [::]:80 default_server;
	listen 3000;
	listen [::]:3000;

	root /var/www/html;
	index index.html index.htm index.nginx-debian.html;
	server_name _;

	# La RACINE affiche le portail.
	location = / {
		try_files /index.html =404;
	}

	# Tout AUTRE chemin appartient a l'application : on redirige vers le vhost
	# 8081 en conservant le chemin et la query string. Cela rattrape les anciens
	# signets (ex. http://10.190.100.58:3000/login -> http://10.190.100.58:8081/login).
	#
	# On ne peut PAS servir l'app directement ici : son routeur React utilise "/"
	# comme dashboard et renvoie tout chemin inconnu vers "/" (App.tsx) — le
	# dashboard tomberait sur le portail. La redirection evite ce conflit.
	#
	# 302 (et non 301) : non mise en cache de facon permanente par le navigateur,
	# on peut donc changer le port de l'app sans laisser des clients bloques.
	location / {
		return 302 http://$host:8081$request_uri;
	}
}
